# Copy this to .env and fill in your values.
# Never commit .env to git.

# Embeddings (pick one)
OLLAMA_BASE_URL=http://localhost:11434
# Maximum concurrent embedding requests across the server (8 texts per batch)
GRAPHRAG_EMBEDDING_CONCURRENCY=4
# Reviewed extraction limits (apply to inline and file ingestion)
GRAPHRAG_MAX_INGEST_BYTES=26214400
GRAPHRAG_MAX_INGEST_RECORDS=50000
# OPENAI_API_KEY=your-key-here

# LLM (pick one)
# ANTHROPIC_API_KEY=your-key-here
# OPENAI_API_KEY=your-key-here

# Neo4j export (optional)
GRAPHRAG_NEO4J_URI=bolt://localhost:7687
GRAPHRAG_NEO4J_USERNAME=neo4j
GRAPHRAG_NEO4J_PASSWORD=
GRAPHRAG_NEO4J_DATABASE=neo4j

# Qdrant export (optional)
GRAPHRAG_QDRANT_URL=http://localhost:6333
GRAPHRAG_QDRANT_API_KEY=
GRAPHRAG_QDRANT_COLLECTION_PREFIX=preciso

# Shared export workspace label
GRAPHRAG_EXPORT_WORKSPACE=default
GRAPHRAG_EXPORT_CLEAR_EXISTING=false
